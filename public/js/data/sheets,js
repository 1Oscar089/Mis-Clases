//
// SOLO TRANSPORTE: arma el sobre HTTP y lo manda. La lógica de qué
// guardar y dónde vive en db.js (lado web) y en code.gs (lado Sheets).
// Ningún módulo fuera de db.js debe importar este archivo.
//
// CONFIGURACIÓN (una sola vez):
//   1. Abre tu hoja de cálculo → Extensiones → Apps Script.
//   2. Pega el código de code.gs → Implementar → Nueva implementación →
//      Tipo: "Aplicación web" · Ejecutar como: yo · Acceso: cualquier
//      persona → Implementar.
//   3. Copia el enlace que termina en /exec y PÉGALO aquí abajo.
//      (No se necesita ID de hoja: con el enlace basta.)
//
// Nota técnica: se envía con POST y Content-Type "text/plain" porque
// Apps Script no responde peticiones OPTIONS (preflight CORS); con
// text/plain el navegador no hace preflight y todo funciona.
// ============================================================

// ⬇️⬇️  PEGA AQUÍ EL ENLACE /exec DEL WEB APP  ⬇️⬇️
export const URL_WEB_APP = "https://script.google.com/macros/s/AKfycbyp3UCM5x4dQUvDkJBDxAc_3xZgrYFyhJnB7CICPLl7Nm-oRxoc6WDVvRGU5M698ptn/exec";

const TIMEOUT_MS = 8000;

/** true si el enlace del Web App ya está configurado. */
export function configurada() {
  return /^https:\/\/script\.google\.com\/.+\/exec/.test(String(URL_WEB_APP).trim());
}

/**
 * Envía {accion, ...datos} al Web App y devuelve su JSON de respuesta.
 * NUNCA lanza excepciones: si algo falla devuelve { ok:false, razon },
 * así la app sigue funcionando aunque Sheets no responda.
 */
export async function llamar(accion, datos = {}) {
  if (!configurada()) return { ok: false, razon: "sin-url" };

  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);

  try {
    const res = await fetch(URL_WEB_APP.trim(), {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify({ accion, ...datos }),
      signal: ctrl.signal,
    });
    const data = await res.json();
    return { ok: true, ...data };
  } catch (e) {
    console.warn(`[sheets] «${accion}» falló:`, e?.message || e);
    return { ok: false, razon: "red" };
  } finally {
    clearTimeout(timer);
  }
}